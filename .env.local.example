# ---------------------------------------------------------------- Supabase --
# Project Settings → API. The anon key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role. SERVER ONLY — never prefix with
# NEXT_PUBLIC_ and never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Gemini --
# https://aistudio.google.com/apikey — free tier. SERVER ONLY: it is read by
# /api/analyze-meal and never reaches the browser.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash (free tier, vision-capable).
GEMINI_MODEL=
